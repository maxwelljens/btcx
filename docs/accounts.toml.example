# btcx account configuration.
# Location: ~/.config/btcx/accounts/<name>.toml (one file per account).
# The filename stem ("work", "private", ...) is the account name.

display_name = "Maxwell Jensen"
email = "max@example.org"
# real_name = "Maxwell"          # optional; defaults to display_name

[imap]
host = "imap.example.org"
port = 993                       # 993 for tls, 143 for starttls (0 = default)
username = "max@example.org"

# Choose ONE way to provide the password:
password = ""                    # stored in this file (keep it chmod 600!)
password_command = "pass show mail/example.org"   # argv-split, no shell, 10s timeout

tls = "tls"                      # "tls" (implicit, port 993) or "starttls"
# insecure_skip_verify = true    # DANGEROUS: disables certificate checks
# ca_file = "/path/to/ca.pem"    # extra CA bundle for private CAs

[smtp]
host = "smtp.example.org"
port = 587                       # 587 for starttls, 465 for tls (0 = default)
username = "max@example.org"
password_command = "pass show mail/example.org"
tls = "starttls"                 # "tls" (implicit, port 465) or "starttls"

# Server-side folder names for special folders.
[sent]
mailbox = "Sent"
[drafts]
mailbox = "Drafts"
[trash]
mailbox = "Trash"

# Plain-text signature appended to composed messages.
signature = """
--
Maxwell Jensen
"""
